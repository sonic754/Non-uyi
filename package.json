{
  "name": "non-uyi-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test ai-prompt.test.js gemini-client.test.js tests/*.test.js",
    "check": "node --check server.js && node --check public/core.js && node --check public/app.js",
    "evaluate": "node --env-file=.env evaluate-prompt.js",
    "evaluate:analysis": "node --env-file=.env evaluate-analysis.js",
    "evaluate:smoke": "node --env-file=.env evaluate-prompt.js --smoke"
  },
  "engines": { "node": ">=22" }
}
